# Runtime and audit artifacts remain local.
# 注意：/work/ 下的脚本、文档与索引要入库（完整推送），
# 其中的媒体与大体积中间产物由下面的全局规则排除。
/work/**/*.bak
/work/**/*.bin
/work/**/*.runtime.json
/work/**/extracted/
# 设备码登录待处理态，含 device_code / user_code，不得入库
/work/auth-pending.json
rename-body.json
/outputs/
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
!.env.example

# Rebuilt locally from our bridge source; not a bundled official engine.
/bridge/jy14_codec_hardened_11_4
/bridge/jy14_codec_hardened
/bridge/jy14_codec_pipe*

# Official applications, binaries, user drafts, media and credential stores
# must never be added as project content.
*.dylib
*.so
*.dll
*.exe
*.app/
*.mp4
*.mov
*.mp3
*.wav
*.aac
*.m4a
*.png
*.jpg
*.jpeg
*.gif
# Explicitly approved IG case previews only; all other media stays excluded.
!/docs/media/hypit-original-frames.png
!/docs/media/jianying-import-frames.png
!/docs/media/hypit-original-preview.mp4
!/docs/media/jianying-import-preview.mp4
*.ttf
*.otf
*.sqlite
*.sqlite3
*.db
*.keychain*
*.plist
*.log
draft_info.json
draft_meta_info.json
root_meta_info.json
draft_content.json
key_value.json
