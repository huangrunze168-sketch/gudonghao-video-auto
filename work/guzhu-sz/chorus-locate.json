{
  "key": "9e220727e2fb33f3",
  "chorus_us": 67000000,
  "model": "small",
  "segments": [
    {
      "start": 0.0,
      "end": 14.0,
      "text": "Zither Harp"
    },
    {
      "start": 14.0,
      "end": 21.0,
      "text": "至少不是擁有過時我還不肯認說"
    },
    {
      "start": 21.0,
      "end": 29.0,
      "text": "可至少這兩個字從來不算熟"
    },
    {
      "start": 29.0,
      "end": 33.0,
      "text": "你手機的密碼你從來沒打算嗎"
    },
    {
      "start": 33.0,
      "end": 37.0,
      "text": "我一次都沒翻吧翻出來更難看"
    },
    {
      "start": 37.0,
      "end": 40.0,
      "text": "你罵見過我你只說了一半"
    },
    {
      "start": 40.0,
      "end": 43.0,
      "text": "剩下那一半你讓我自己填滿"
    },
    {
      "start": 43.0,
      "end": 47.0,
      "text": "你搬家那天我陪你搬到很晚"
    },
    {
      "start": 47.0,
      "end": 51.0,
      "text": "新家的門牌我一個數字沒幾圈"
    },
    {
      "start": 51.0,
      "end": 55.0,
      "text": "這些是一件沒丟圈手在心上"
    },
    {
      "start": 55.0,
      "end": 58.0,
      "text": "散著散著散著慢慢一想"
    },
    {
      "start": 58.0,
      "end": 62.0,
      "text": "和著一想成不出一點分量"
    },
    {
      "start": 62.0,
      "end": 67.0,
      "text": "因為他們從來沒有名分可講"
    },
    {
      "start": 67.0,
      "end": 70.0,
      "text": "就算你沒在誰面前認過這段"
    },
    {
      "start": 70.0,
      "end": 74.0,
      "text": "就算我在你名單裡拍不到之前"
    },
    {
      "start": 74.0,
      "end": 77.0,
      "text": "就算那句以後你沒說過一遍"
    },
    {
      "start": 77.0,
      "end": 81.0,
      "text": "就算我等到萬一一切沒出現"
    },
    {
      "start": 81.0,
      "end": 85.0,
      "text": "就像你哭的樣子只有我看見"
    },
    {
      "start": 85.0,
      "end": 89.0,
      "text": "就像你最難看到萬我送你去醫院"
    },
    {
      "start": 89.0,
      "end": 96.0,
      "text": "至少不是擁有過時我還不肯認說"
    },
    {
      "start": 96.0,
      "end": 100.0,
      "text": "去年那個機會我本來可以離開"
    },
    {
      "start": 100.0,
      "end": 103.0,
      "text": "我沒走怕你半夜打來我不在"
    },
    {
      "start": 103.0,
      "end": 106.0,
      "text": "朋友罵我傻我說你們不明白"
    },
    {
      "start": 106.0,
      "end": 110.0,
      "text": "後來你有了別人我從旁人那聽來"
    },
    {
      "start": 110.0,
      "end": 117.0,
      "text": "你帶走得出了心裡還有我在"
    },
    {
      "start": 117.0,
      "end": 121.0,
      "text": "就算我早就知道會有這一天"
    },
    {
      "start": 121.0,
      "end": 125.0,
      "text": "就算你從沒許過一句諾言"
    },
    {
      "start": 125.0,
      "end": 128.0,
      "text": "就算到最後我連名分都沒站"
    },
    {
      "start": 128.0,
      "end": 132.0,
      "text": "就算我把這樣一筆一筆都算完"
    },
    {
      "start": 132.0,
      "end": 136.0,
      "text": "就像我沒讓你以為難過一天"
    },
    {
      "start": 136.0,
      "end": 140.0,
      "text": "就像我沒在你面前紅過眼"
    },
    {
      "start": 140.0,
      "end": 147.0,
      "text": "至少不是深情是我把貪心說得好聽"
    },
    {
      "start": 147.0,
      "end": 150.0,
      "text": "我從來沒想要一句至少"
    },
    {
      "start": 150.0,
      "end": 154.0,
      "text": "我要的是名字說的出口"
    },
    {
      "start": 154.0,
      "end": 157.0,
      "text": "我要的是介紹不是旋律"
    },
    {
      "start": 157.0,
      "end": 161.0,
      "text": "這次我說的太順順到自己都想哭"
    },
    {
      "start": 161.0,
      "end": 168.0,
      "text": "太貪心的人連至少都留不住"
    },
    {
      "start": 168.0,
      "end": 172.0,
      "text": "就算我在的這些全都上不了太面"
    },
    {
      "start": 172.0,
      "end": 176.0,
      "text": "就算你到最後也不承認這一段"
    },
    {
      "start": 176.0,
      "end": 179.0,
      "text": "就算至少這兩個字不算數"
    },
    {
      "start": 179.0,
      "end": 183.0,
      "text": "我也不會把他們笑完"
    },
    {
      "start": 183.0,
      "end": 186.0,
      "text": "至少不是擁有過"
    },
    {
      "start": 186.0,
      "end": 188.0,
      "text": "我也不是不肯認屬"
    },
    {
      "start": 188.0,
      "end": 193.0,
      "text": "是我終於承認"
    },
    {
      "start": 193.0,
      "end": 198.0,
      "text": "我想要個名分"
    },
    {
      "start": 198.0,
      "end": 201.0,
      "text": "至少不是擁有過"
    },
    {
      "start": 201.0,
      "end": 206.0,
      "text": "是我後來才敢承認"
    },
    {
      "start": 206.0,
      "end": 208.0,
      "text": "我想要個名分"
    },
    {
      "start": 208.0,
      "end": 212.0,
      "text": "跟你沒關係了"
    },
    {
      "start": 216.0,
      "end": 220.0,
      "text": "我只想要你"
    },
    {
      "start": 220.0,
      "end": 224.0,
      "text": "我只想要你"
    },
    {
      "start": 224.0,
      "end": 228.0,
      "text": "我只想要你"
    }
  ]
}
