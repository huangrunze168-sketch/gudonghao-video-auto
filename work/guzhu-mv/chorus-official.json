  "rows": [
    {
      "start_us": 6066666,
      "duration_us": 5233334,
      "text": "战鼓又雷动 我君扶边守"
    },
    {
      "start_us": 11933333,
      "duration_us": 5433333,
      "text": "家书从未有 心念念不休"
    },
    {
      "start_us": 17400000,
      "duration_us": 2966666,
      "text": "你送的胭脂扣 是我的心头忧"
    },
    {
      "start_us": 20366666,
      "duration_us": 3033334,
      "text": "我们的十指紧扣 在那一夜缠绵后"
    },
    {
      "start_us": 23400000,
      "duration_us": 2966666,
      "text": "你席正为等候 我编织的红袖"
    },
    {
      "start_us": 26366666,
      "duration_us": 2900000,
      "text": "今夜的新妆到底他是为谁浓"
    },
    {
      "start_us": 29266666,
      "duration_us": 3266667,
      "text": "金戈铁马 身披起凌甲"
    },
    {
      "start_us": 32533333,
      "duration_us": 2833333,
      "text": "我要追你到落霞"
    },
    {
      "start_us": 35466666,
      "duration_us": 5833334,
      "text": "琵琶秋色下 望寒樽饮马 举目望月牙"
    },
    {
      "start_us": 41666666,
      "duration_us": 5600000,
      "text": "孤雁飞尽漫天弄狂沙 萧萧良人你在哪"
    },
    {
      "start_us": 47366666,
      "duration_us": 3366667,
      "text": "江风落蒹葭 漠北共飒飒"
    },
    {
      "start_us": 50733333,
      "duration_us": 2533333,
      "text": "换你到白发"
    }
  ]
