[
  {
    "segment": "48347980-40EA-4955-BC61-6C1C0F4B82B6",
    "start_us": 6833333,
    "text": "有一些"
  },
  {
    "segment": "A58998EB-A9A9-4ebf-AEFC-C3D4E2324329",
    "start_us": 7366666,
    "text": "瞬间我在"
  },
  {
    "segment": "A1FAFAC8-605D-4564-9EF7-A0C90030CEB3",
    "start_us": 8433333,
    "text": "命运之外"
  },
  {
    "segment": "ABB3FC49-57C3-49e7-ACDB-155487120560",
    "start_us": 10666666,
    "text": "楼下站着"
  },
  {
    "segment": "F6C1FD93-F619-4779-BC90-18E4F96F5BDB",
    "start_us": 11533333,
    "text": "一直在发呆"
  },
  {
    "segment": "E8CF2E80-493B-4463-882C-331A05E7EAE7",
    "start_us": 14000000,
    "text": "屏幕亮起"
  },
  {
    "segment": "8D43EEB3-3AD6-44b5-913D-1E269BEFBE01",
    "start_us": 15033333,
    "text": "来我"
  },
  {
    "segment": "E1DAC975-968E-428e-80DA-CAD666D31BC8",
    "start_us": 16366666,
    "text": "没理睬"
  },
  {
    "segment": "E0F0A58B-50FE-4962-BC21-8EC109858E42",
    "start_us": 17600000,
    "text": "那几分"
  },
  {
    "segment": "35AEB6E6-B3D6-4d0c-BA72-D9A09C2DAFE6",
    "start_us": 18066666,
    "text": "钟我"
  },
  {
    "segment": "4B8FF7AE-52FF-4741-B4B3-92696F578E68",
    "start_us": 19300000,
    "text": "才算存在"
  },
  {
    "segment": "4E13E29B-9CF1-4698-97F0-6D963A2F0FED",
    "start_us": 21300000,
    "text": "你也试"
  },
  {
    "segment": "758C0CB0-2883-46ba-9B66-03D302EA7F57",
    "start_us": 22000000,
    "text": "过吧不"
  },
  {
    "segment": "32EED5BA-FFDD-425e-AEE2-530172598ECD",
    "start_us": 22866666,
    "text": "想上来"
  },
  {
    "segment": "51D0B76C-9924-45c7-86A1-F9FF8B8EF838",
    "start_us": 24833333,
    "text": "掏钥匙的"
  },
  {
    "segment": "BA5A9736-D082-4b39-8575-0530F97D0F8D",
    "start_us": 25900000,
    "text": "手慢了半拍"
  },
  {
    "segment": "7E67A14D-7905-4726-AC17-8C6028541C20",
    "start_us": 28600000,
    "text": "呼一口"
  },
  {
    "segment": "CCA49797-F9E7-4c06-9ACE-596DF78FED23",
    "start_us": 29766666,
    "text": "气才"
  }
]