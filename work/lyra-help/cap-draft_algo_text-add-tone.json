r\n                              1500000us\r\n          --target-track-index TEXT \r\n                              Target audio track index\r\n          --replace TEXT      Replace existing text-reading audio bound to the target: true /\r\n                              false\r\n          --provider-params-json TEXT \r\n                              Provider-specific parameters as a JSON object or @path\r\n  -v,     --version           Show version information and exit.\r\n          --jq TEXT           Pretty-print JSON output; with an optional selector like\r\n                              .result.items[0].id, output the selected JSON value instead of\r\n                              the full schema envelope.\r\n\r\nEXAMPLES\r\n  # Tag a text segment with a happy tone at normal speed\r\n  $ lyra-cli draft algo text-add-tone --speed 1.0 --emotion happy --seg-id <UUID>\r\n  # Reuse an existing tone product\r\n  $ lyra-cli draft algo text-add-tone --resource-id <tone_id> --audio-path /tmp/tone.wav --seg-id <UUID>\r\n",
