    "result": {
      "ok": true,
      "stdout": "Detect and apply intelligent subtitle keyword highlights.\r\n\r\nAGENT QUICKSTART (driving this as an agent? start here):\r\n  Browse commands:  lyra-cli <domain> --help\r\n\r\nUSAGE:\r\n  lyra-cli <domain> <[subdomain] ...> <action> [--flags] [--options]\r\n\r\n\r\nOPTIONS:\r\n  -h,     --help              Print this help message and exit\r\n          --ref TEXT          Unified draft reference\r\n          --seg-id TEXT       Optional target segment id (raw id, no seg_id= prefix)\r\n          --language TEXT     Recognition language (BCP-47 code), e.g. zh / en / ja-JP\r\n          --apply TEXT        Apply detected keyword ranges to the draft: true / false (default\r\n                              true)\r\n          --replace           Replace existing keyword ranges on the selected subtitle segments\r\n  -v,     --version           Show version information and exit.\r\n          --jq TEXT           Pretty-print JSON output; with an optional selector like\r\n                              .result.items[0].id, output the selected JSON value instead of\r\n                              the full schema envelope.\r\n\r\nEXAMPLES\r\n  # Detect keyword highlights for all subtitle segments and apply them\r\n  $ lyra-cli draft algo subtitle-keywords --language zh\r\n  # Detect a selected subtitle segment and replace existing highlights\r\n  $ lyra-cli draft algo subtitle-keywords --language zh --replace --seg-id <UUID>\r\n  # Only return detected ranges without modifying the draft\r\n  $ lyra-cli draft algo subtitle-keywords --language en --apply false --seg-id <UUID>\r\n",
      "stderr": "",
      "output": "Detect and apply intelligent subtitle keyword highlights.\r\n\r\nAGENT QUICKSTART (driving this as an agent? start here):\r\n  Browse commands:  lyra-cli <domain> --help\r\n\r\nUSAGE:\r\n  lyra-cli <domain> <[subdomain] ...> <action> [--flags] [--options]\r\n\r\n\r\nOPTIONS:\r\n  -h,     --help              Print this help message and exit\r\n          --ref TEXT          Unified draft reference\r\n          --seg-id TEXT       Optional target segment id (raw id, no seg_id= prefix)\r\n          --language TEXT     Recognition language (BCP-47 code), e.g. zh / en / ja-JP\r\n          --apply TEXT        Apply detected keyword ranges to the draft: true / false (default\r\n                              true)\r\n          --replace           Replace existing keyword ranges on the selected subtitle segments\r\n  -v,     --version           Show version information and exit.\r\n          --jq TEXT           Pretty-print JSON output; with an optional selector like\r\n                              .result.items[0].id, output the selected JSON value instead of\r\n                              the full schema envelope.\r\n\r\nEXAMPLES\r\n  # Detect keyword highlights for all subtitle segments and apply them\r\n  $ lyra-cli draft algo subtitle-keywords --language zh\r\n  # Detect a selected subtitle segment and replace existing highlights\r\n  $ lyra-cli draft algo subtitle-keywords --language zh --replace --seg-id <UUID>\r\n  # Only return detected ranges without modifying the draft\r\n  $ lyra-cli draft algo subtitle-keywords --language en --apply false --seg-id <UUID>\r\n",
