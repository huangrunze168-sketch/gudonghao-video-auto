{
  "key": "b84b8f352f493a2b",
  "chorus_us": 54000000,
  "model": "small",
  "segments": [
    {
      "start": 0.0,
      "end": 13.0,
      "text": "Zither Harp"
    },
    {
      "start": 14.0,
      "end": 17.0,
      "text": "你說到上沒有白天"
    },
    {
      "start": 17.0,
      "end": 20.0,
      "text": "只有一扇沒關的窗"
    },
    {
      "start": 20.0,
      "end": 23.0,
      "text": "我沿著你留下的腳印"
    },
    {
      "start": 23.0,
      "end": 27.0,
      "text": "走進一場秋夢中央"
    },
    {
      "start": 28.0,
      "end": 33.0,
      "text": "面包墊還亮著暖光"
    },
    {
      "start": 34.0,
      "end": 40.0,
      "text": "你把我的名字寫在牆"
    },
    {
      "start": 41.0,
      "end": 45.0,
      "text": "你說別問穿什麼時候靠岸"
    },
    {
      "start": 45.0,
      "end": 48.0,
      "text": "別問誰先把誰遺忘"
    },
    {
      "start": 48.0,
      "end": 50.0,
      "text": "我伸手碰到你的臉龐"
    },
    {
      "start": 50.0,
      "end": 54.0,
      "text": "指尖卻隔著一面透明的牆"
    },
    {
      "start": 54.0,
      "end": 57.0,
      "text": "如果這座道是你留的一道光"
    },
    {
      "start": 57.0,
      "end": 60.0,
      "text": "能不能再聽一聽聽你傾聲響"
    },
    {
      "start": 60.0,
      "end": 63.0,
      "text": "就算是高平 先殺過的方"
    },
    {
      "start": 63.0,
      "end": 67.0,
      "text": "跟著你的腳印去就夢中央"
    },
    {
      "start": 67.0,
      "end": 71.0,
      "text": "到晚遺忘無計是故鄉的方向"
    },
    {
      "start": 71.0,
      "end": 74.0,
      "text": "夢裡遺忘無計我該去向何方"
    },
    {
      "start": 74.0,
      "end": 76.0,
      "text": "假如穿扣不了岸"
    },
    {
      "start": 76.0,
      "end": 78.0,
      "text": "就把鑰匙別在心上"
    },
    {
      "start": 78.0,
      "end": 83.0,
      "text": "說好別讓我一個人煩惱"
    },
    {
      "start": 84.0,
      "end": 97.0,
      "text": "Zither Harp"
    },
    {
      "start": 98.0,
      "end": 102.0,
      "text": "你說別問穿什麼時候靠岸"
    },
    {
      "start": 102.0,
      "end": 105.0,
      "text": "別問誰先把誰遺忘"
    },
    {
      "start": 105.0,
      "end": 108.0,
      "text": "我伸手碰到你的臉龐"
    },
    {
      "start": 108.0,
      "end": 111.0,
      "text": "指尖卻隔著一面透明的牆"
    },
    {
      "start": 111.0,
      "end": 114.0,
      "text": "如果這座道是你留的一道光"
    },
    {
      "start": 114.0,
      "end": 118.0,
      "text": "能不能再聽一聽聽你傾聲響"
    },
    {
      "start": 118.0,
      "end": 121.0,
      "text": "就算是高平 先殺過的方"
    },
    {
      "start": 121.0,
      "end": 125.0,
      "text": "跟著你的目光我才看得亮"
    },
    {
      "start": 125.0,
      "end": 128.0,
      "text": "到晚遺忘無計是你懸的遠方"
    },
    {
      "start": 128.0,
      "end": 132.0,
      "text": "夢裡遺忘無計我不在慌張"
    },
    {
      "start": 132.0,
      "end": 134.0,
      "text": "假如穿扣不了岸"
    },
    {
      "start": 134.0,
      "end": 136.0,
      "text": "就把你的話別在心上"
    },
    {
      "start": 136.0,
      "end": 140.0,
      "text": "你會留下愛是陪我回顧香"
    },
    {
      "start": 141.0,
      "end": 145.0,
      "text": "我終於看見門後的真相"
    },
    {
      "start": 145.0,
      "end": 148.0,
      "text": "那不是你的假想"
    },
    {
      "start": 148.0,
      "end": 151.0,
      "text": "是你把來不及說的話"
    },
    {
      "start": 151.0,
      "end": 155.0,
      "text": "一夜一夜藏進我的夢想"
    },
    {
      "start": 155.0,
      "end": 157.0,
      "text": "所以你在笑著說"
    },
    {
      "start": 157.0,
      "end": 159.0,
      "text": "別回頭"
    },
    {
      "start": 159.0,
      "end": 162.0,
      "text": "把鑰匙撒回我手掌"
    },
    {
      "start": 162.0,
      "end": 165.0,
      "text": "你留在道上不是懲罰"
    },
    {
      "start": 165.0,
      "end": 172.0,
      "text": "是讓我活下去的方向"
    },
    {
      "start": 172.0,
      "end": 175.0,
      "text": "如果這座道是你留的一道光"
    },
    {
      "start": 175.0,
      "end": 177.0,
      "text": "能不能再看一看"
    },
    {
      "start": 177.0,
      "end": 179.0,
      "text": "看你的臉龐"
    },
    {
      "start": 179.0,
      "end": 181.0,
      "text": "就算是高平 先殺過的方"
    },
    {
      "start": 181.0,
      "end": 185.0,
      "text": "跟著你的目光我去看太陽"
    },
    {
      "start": 185.0,
      "end": 189.0,
      "text": "到晚遺忘無計是故鄉的方向"
    },
    {
      "start": 189.0,
      "end": 193.0,
      "text": "夢裡遺忘無計我已學會不慌"
    },
    {
      "start": 193.0,
      "end": 195.0,
      "text": "假如你也在抬頭看"
    },
    {
      "start": 195.0,
      "end": 197.0,
      "text": "每一個醒來的太陽"
    },
    {
      "start": 197.0,
      "end": 209.0,
      "text": "願你留下也願你走向遠方"
    }
  ]
}
