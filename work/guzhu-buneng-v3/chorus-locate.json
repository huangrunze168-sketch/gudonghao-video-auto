  "model": "small",
  "segments": [
    {
      "start": 0.0,
      "end": 15.0,
      "text": "Zither Harp"
    },
    {
      "start": 15.0,
      "end": 18.0,
      "text": "腦中想過起點吧"
    },
    {
      "start": 18.0,
      "end": 22.0,
      "text": "我沒再天開那一欄"
    },
    {
      "start": 22.0,
      "end": 25.0,
      "text": "你的頭上換了幾把"
    },
    {
      "start": 25.0,
      "end": 29.0,
      "text": "我竟然沒細看"
    },
    {
      "start": 29.0,
      "end": 32.0,
      "text": "路過長去的那家店"
    },
    {
      "start": 32.0,
      "end": 35.0,
      "text": "點人還問老習慣"
    },
    {
      "start": 35.0,
      "end": 38.0,
      "text": "我說今天換你整天"
    },
    {
      "start": 38.0,
      "end": 42.0,
      "text": "沒有覺得背叛"
    },
    {
      "start": 42.0,
      "end": 45.0,
      "text": "曾把美劇沉默處在拆開"
    },
    {
      "start": 45.0,
      "end": 49.0,
      "text": "想找出那一秒你不再愛"
    },
    {
      "start": 49.0,
      "end": 52.0,
      "text": "後來慢著生活沒空中來"
    },
    {
      "start": 52.0,
      "end": 56.0,
      "text": "才發現我早已不再等待"
    },
    {
      "start": 56.0,
      "end": 59.0,
      "text": "突然某天我不再需要等"
    },
    {
      "start": 59.0,
      "end": 63.0,
      "text": "你愛沒愛過都不必再深叛"
    },
    {
      "start": 63.0,
      "end": 66.0,
      "text": "那些沒說完就停在沒說完"
    },
    {
      "start": 66.0,
      "end": 70.0,
      "text": "把困在門外的自己淋回身邊"
    },
    {
      "start": 70.0,
      "end": 73.0,
      "text": "突然某天我不再需要等"
    },
    {
      "start": 73.0,
      "end": 77.0,
      "text": "承認有些人只陪一段"
    },
    {
      "start": 77.0,
      "end": 80.0,
      "text": "我沒有是壞的多麼好看"
    },
    {
      "start": 80.0,
      "end": 84.0,
      "text": "只是路過路口腳步沒有放慢"
    },
    {
      "start": 84.0,
      "end": 87.0,
      "text": "曾把美劇沉默處在拆開"
