  "rows": [
    {
      "start_us": 26166666,
      "duration_us": 2800000,
      "text": "你把再见说得太自然"
    },
    {
      "start_us": 28966666,
      "duration_us": 3600000,
      "text": "我挥挥手笑得也很淡"
    },
    {
      "start_us": 32866666,
      "duration_us": 3133334,
      "text": "你转身挤进人群之前"
    },
    {
      "start_us": 36000000,
      "duration_us": 3400000,
      "text": "我们都没敢多看一眼"
    },
    {
      "start_us": 39400000,
      "duration_us": 3166666,
      "text": "没说完的那句喜欢"
    },
    {
      "start_us": 42566666,
      "duration_us": 3433334,
      "text": "和没外腻的那把伞"
    },
    {
      "start_us": 46000000,
      "duration_us": 3366666,
      "text": "都还停在那个雨天"
    },
    {
      "start_us": 49566666,
      "duration_us": 3000000,
      "text": "从此再没见上一面"
    },
    {
      "start_us": 52733333,
      "duration_us": 2033333,
      "text": "我总以为还能再见"
    },
    {
      "start_us": 54766666,
      "duration_us": 1966667,
      "text": "把再见当成个逗点"
    },
    {
      "start_us": 56733333,
      "duration_us": 2766667,
      "text": "可你走的那么突然"
    },
    {
      "start_us": 59500000,
      "duration_us": 3933333,
      "text": "我们的故事划上句点"
    },
    {
      "start_us": 65933333,
      "duration_us": 3400000,
      "text": "原来再见不是下次再见"
    },
    {
      "start_us": 69333333,
      "duration_us": 3766667,
      "text": "把没说完的话往下咽"
    },
    {
      "start_us": 73133333,
      "duration_us": 3000000,
      "text": "故作洒脱说句该听见"
    },
    {
      "start_us": 76133333,
      "duration_us": 3366667,
      "text": "怕你回头我就不敢看"
    },
    {
      "start_us": 79500000,
      "duration_us": 3400000,
      "text": "原来再见而是再也不见"
    },
    {
      "start_us": 82900000,
      "duration_us": 3766666,
      "text": "那借给你的那把伞"
    },
    {
      "start_us": 86900000,
      "duration_us": 2900000,
      "text": "耗尽我们最后那点缘"
    },
    {
      "start_us": 89800000,
      "duration_us": 5100000,
      "text": "连再见都说得那么心酸"
    },
    {
      "start_us": 97500000,
      "duration_us": 2600000,
      "text": "你拉黑了我的来电"
    },
    {
      "start_us": 100166666,
      "duration_us": 3166667,
      "text": "删掉了合照那张照片"
    },
    {
      "start_us": 103333333,
      "duration_us": 3433333,
      "text": "原来你的离开不是突然"
    },
    {
      "start_us": 106766666,
      "duration_us": 3500000,
      "text": "是你早就算好的句点"
    },
    {
      "start_us": 110266666,
      "duration_us": 3233334,
      "text": "我还留着你的伞"
    },
    {
      "start_us": 113500000,
      "duration_us": 3366666,
      "text": "和那句没寄出的晚安"
    },
    {
      "start_us": 116866666,
      "duration_us": 3000000,
      "text": "可流星划过了那个时间"
    },
    {
      "start_us": 119866666,
      "duration_us": 3533334,
      "text": "就再也没人想听我说完"
    },
    {
      "start_us": 123400000,
      "duration_us": 3266666,
      "text": "原来再见不是下次再见"
    },
    {
      "start_us": 126666666,
      "duration_us": 3800000,
      "text": "把聊天框清空的那一晚"
    },
    {
      "start_us": 130866666,
      "duration_us": 2533334,
      "text": "不做没事烦你的空间"
    },
    {
      "start_us": 133400000,
      "duration_us": 3566666,
      "text": "怕看到你身边有新欢"
    },
    {
      "start_us": 136966666,
      "duration_us": 3333334,
      "text": "原来再见而是再也不见"
    },
    {
      "start_us": 140300000,
      "duration_us": 3600000,
      "text": "那些没寄出的晚安"
    },
    {
      "start_us": 144300000,
      "duration_us": 3066666,
      "text": "耗尽我留你的那点暖"
    },
    {
      "start_us": 147366666,
      "duration_us": 3500000,
      "text": "连想你都不敢太明显"
    },
    {
      "start_us": 151933333,
      "duration_us": 1666667,
      "text": "其实你说再见"
    },
    {
      "start_us": 153600000,
      "duration_us": 3900000,
      "text": "那晚我早听出你声音发展"
    },
    {
      "start_us": 157500000,
      "duration_us": 3300000,
      "text": "只是我不敢拆穿"
    },
    {
      "start_us": 160800000,
      "duration_us": 3766666,
      "text": "怕拆穿了就真的算完"
    },
    {
      "start_us": 165333333,
      "duration_us": 800000,
      "text": "哎哎"
    },
    {
      "start_us": 167400000,
      "duration_us": 3166666,
      "text": "原来再见不是下次再见"
    },
    {
      "start_us": 170566666,
      "duration_us": 3900000,
      "text": "把从前都收进箱 里边"
    },
    {
      "start_us": 174533333,
      "duration_us": 3000000,
      "text": "故作释然说句别想念"
    },
    {
      "start_us": 177533333,
      "duration_us": 3400000,
      "text": "怕再多说就红着眼"
    },
    {
      "start_us": 180933333,
      "duration_us": 3366667,
      "text": "原来再见而是再也不见"
    },
    {
      "start_us": 184300000,
      "duration_us": 3866666,
      "text": "那场雨淋湿的那天"
    },
    {
      "start_us": 188166666,
      "duration_us": 3200000,
      "text": "把欠你的那点甜 算完"
    },
    {
