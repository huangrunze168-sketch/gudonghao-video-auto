{
  "key": "78aa8e344747cb41",
  "chorus_us": 56000000,
  "model": "small",
  "segments": [
    {
      "start": 0.0,
      "end": 16.0,
      "text": "Zither Harp"
    },
    {
      "start": 16.0,
      "end": 19.0,
      "text": "你把再見說得太自然"
    },
    {
      "start": 19.0,
      "end": 23.0,
      "text": "我揮揮手笑的也很淡"
    },
    {
      "start": 23.0,
      "end": 26.0,
      "text": "你轉身寄進人群之前"
    },
    {
      "start": 26.0,
      "end": 29.0,
      "text": "我們都沒敢多看一眼"
    },
    {
      "start": 29.0,
      "end": 32.0,
      "text": "沒說完的那句喜歡"
    },
    {
      "start": 32.0,
      "end": 36.0,
      "text": "很沒愛你的那巴掃"
    },
    {
      "start": 36.0,
      "end": 39.0,
      "text": "都還停在那個雨天"
    },
    {
      "start": 39.0,
      "end": 42.0,
      "text": "從此在沒見上一面"
    },
    {
      "start": 42.0,
      "end": 45.0,
      "text": "我總以為還能再見"
    },
    {
      "start": 45.0,
      "end": 47.0,
      "text": "把再見當成個逗點"
    },
    {
      "start": 47.0,
      "end": 49.0,
      "text": "和你走得那麼突然"
    },
    {
      "start": 49.0,
      "end": 56.0,
      "text": "我們的故事劃上句點"
    },
    {
      "start": 56.0,
      "end": 59.0,
      "text": "原來再見不是下次再見"
    },
    {
      "start": 59.0,
      "end": 63.0,
      "text": "把沒說完的話往下演"
    },
    {
      "start": 63.0,
      "end": 66.0,
      "text": "不做灑脫說句改天間"
    },
    {
      "start": 66.0,
      "end": 69.0,
      "text": "怕你回頭我就不敢看"
    },
    {
      "start": 69.0,
      "end": 73.0,
      "text": "原來再見而實在也不見"
    },
    {
      "start": 73.0,
      "end": 76.0,
      "text": "那些給你的那巴掃"
    },
    {
      "start": 76.0,
      "end": 80.0,
      "text": "好緊我們最後那點緣"
    },
    {
      "start": 80.0,
      "end": 88.0,
      "text": "連再見都說得那麼心酸"
    },
    {
      "start": 88.0,
      "end": 90.0,
      "text": "你落了我的來電"
    },
    {
      "start": 90.0,
      "end": 93.0,
      "text": "剩掉了合照那張照片"
    },
    {
      "start": 93.0,
      "end": 97.0,
      "text": "原來你的離開不是突然"
    },
    {
      "start": 97.0,
      "end": 100.0,
      "text": "是你早就算好的句點"
    },
    {
      "start": 100.0,
      "end": 103.0,
      "text": "我還留著你的散"
    },
    {
      "start": 103.0,
      "end": 107.0,
      "text": "和那句沒記住的晚安"
    },
    {
      "start": 107.0,
      "end": 110.0,
      "text": "可有些花過了那個時間"
    },
    {
      "start": 110.0,
      "end": 114.0,
      "text": "只再也沒人想聽我說完"
    },
    {
      "start": 114.0,
      "end": 117.0,
      "text": "原來再見不是下次再見"
    },
    {
      "start": 117.0,
      "end": 121.0,
      "text": "把聊天空清空的那一晚"
    },
    {
      "start": 121.0,
      "end": 124.0,
      "text": "不做沒示範你的空間"
    },
    {
      "start": 124.0,
      "end": 127.0,
      "text": "怕看到你身邊有新歡"
    },
    {
      "start": 127.0,
      "end": 131.0,
      "text": "原來再見而實在也不見"
    },
    {
      "start": 131.0,
      "end": 134.0,
      "text": "那些沒記住的晚安"
    },
    {
      "start": 134.0,
      "end": 137.0,
      "text": "好緊我留你的那點緣"
    },
    {
      "start": 137.0,
      "end": 142.0,
      "text": "也想你都不敢太明顯"
    },
    {
      "start": 142.0,
      "end": 144.0,
      "text": "即使你說再見那晚"
    },
    {
      "start": 144.0,
      "end": 147.0,
      "text": "我早聽出你聲音發展"
    },
    {
      "start": 147.0,
      "end": 151.0,
      "text": "只是我不敢猜穿"
    },
    {
      "start": 151.0,
      "end": 157.0,
      "text": "怕猜穿了就真的算完"
    },
    {
      "start": 157.0,
      "end": 160.0,
      "text": "原來再見不是下次再見"
    },
    {
      "start": 160.0,
      "end": 162.0,
      "text": "把從前都"
    },
    {
      "start": 162.0,
      "end": 164.0,
      "text": "收進箱裡變"
    },
    {
      "start": 164.0,
      "end": 167.0,
      "text": "故作詩人說句別想念"
    },
    {
      "start": 167.0,
      "end": 171.0,
      "text": "怕再多說就紅著眼"
    },
    {
      "start": 171.0,
      "end": 174.0,
      "text": "原來再見而實在也不見"
    },
    {
      "start": 174.0,
      "end": 178.0,
      "text": "大場與臨時的那天"
    },
    {
      "start": 178.0,
      "end": 181.0,
      "text": "把前你的那天天算完"
    },
    {
      "start": 181.0,
      "end": 188.0,
      "text": "這一次換我先說再見"
    },
    {
      "start": 192.0,
      "end": 197.0,
      "text": "詞曲 李宗盛"
    }
  ]
}
